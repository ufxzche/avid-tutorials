{
  "name": "avid-tutorials",
  "version": "2.0.0",
  "description": "AVID onlayn darslar platformasi (Laravel backend)",
  "private": true,
  "scripts": {
    "start": "cd backend && php artisan serve --host=127.0.0.1 --port=3000",
    "migrate": "cd backend && php artisan migrate:fresh --seed",
    "setup": "cd backend && composer install && php artisan key:generate --force && php artisan migrate:fresh --seed"
  }
}
